# Store text as LF in the repo and check it out as LF on every platform.
# Unity and Visual Studio both handle LF on Windows, and CI runs on Linux.
* text=auto eol=lf

# Code
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.compute   text
*.asmdef    text
*.asmref    text
*.json      text
*.md        text

# Unity YAML assets. The unityyamlmerge driver is Unity's Smart Merge tool;
# see README for the one-time local setup. Without it, git falls back to a
# normal text merge.
*.unity     text merge=unityyamlmerge
*.prefab    text merge=unityyamlmerge
*.asset     text merge=unityyamlmerge
*.mat       text merge=unityyamlmerge
*.anim      text merge=unityyamlmerge
*.controller text merge=unityyamlmerge
*.physicMaterial text merge=unityyamlmerge
*.meta      text merge=unityyamlmerge
*.inputactions text

# Binary assets: never diff or normalize. Move these to Git LFS if large
# binaries (textures, models, audio) start being committed.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.tga       binary
*.psd       binary
*.exr       binary
*.hdr       binary
*.raw       binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.ttf       binary
*.otf       binary
*.dll       binary
